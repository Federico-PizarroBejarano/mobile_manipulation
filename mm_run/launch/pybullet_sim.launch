<?xml version="1.0"?>
<!-- Launches the ROS-based simulation. -->

<launch>
  <arg name="config"/>
  <arg name="ctrl_config" default="default" doc="overlay YAML merged into sim config (duration, log_dir)"/>
  <arg name="logging_sub_folder" default="default"/>
  <arg name="gui" default="false" doc="Enable PyBullet GUI"/>
  <arg name="sim_lockstep" default="true" doc="advance sim only after each control cycle (GUI-safe)"/>

  <!-- use simulation time -->
  <param name="/use_sim_time" value="true" type="bool"/>
  <param name="/mm_run/sim_lockstep" value="$(arg sim_lockstep)"/>

  <!-- Simulation -->
  <group if="$(arg gui)">
    <node pkg="mm_run" type="sim_ros.py" name="sim_ros" output="screen" required="true"
          args="--config $(arg config) --ctrl_config $(arg ctrl_config) --GUI --logging_sub_folder $(arg logging_sub_folder)"/>
  </group>
  <group unless="$(arg gui)">
    <node pkg="mm_run" type="sim_ros.py" name="sim_ros" output="screen" required="true"
          args="--config $(arg config) --ctrl_config $(arg ctrl_config) --logging_sub_folder $(arg logging_sub_folder)"/>
  </group>
</launch>
