<?xml version="1.0" encoding="utf-8"?>
<robot name="end_effector_empty" xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- TCP / fingertips frame (~0.29 m from gripper). Visual marker only; MPC
       collision for the hand lives on gripper_* links in collision.urdf.xacro. -->
  <joint name="gripped_object_joint" type="fixed">
    <xacro:transformed_origin name="gripped_object_transform" />
    <parent link="gripper"/>
    <child link="gripped_object"/>
  </joint>
  <!-- When oriented forward: z forward, x down, y left.
       When oriented up (balancing): z up, x forward, y left. -->
  <link name="gripped_object">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="tcp_marker">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
</robot>
